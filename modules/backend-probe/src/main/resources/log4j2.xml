<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="ERROR">
    <Appenders>
        <Console name="Console" target="SYSTEM_ERR">
            <PatternLayout pattern="%level %c: %msg%n%throwable"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="${env:LOG_LEVEL:-error}">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
